{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {% for m in measurements %}
        {
            "date": "{{ m.date|date('Y-m-d')|raw }}",
            "celsius": {{ m.temperature }},
            "fahrenheit": {{ m.fahrenheit }},
            "humidity": {{ m.humidity }},
            "cloudCover": {{ m.cloudCover }},
            "airPressure": {{ m.airPressure }},
            "precipitation": {{ m.precipitation }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
